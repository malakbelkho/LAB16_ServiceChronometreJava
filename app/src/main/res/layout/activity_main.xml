<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pulse_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PulseChrono"
            android:textColor="@color/pulse_white"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foreground + Bound Service en Java"
            android:textColor="@color/pulse_soft"
            android:textSize="15sp"
            android:layout_marginBottom="28dp" />

        <LinearLayout
            android:id="@+id/mainPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_panel"
            android:elevation="14dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip"
                android:text="● Service inactif"
                android:textColor="@color/pulse_dark_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="22dp" />

            <TextView
                android:id="@+id/txtTimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_time_badge"
                android:gravity="center"
                android:text="00:00"
                android:textColor="@color/pulse_white"
                android:textSize="58sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/txtHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Le chronomètre continue même si l’application est fermée."
                android:textColor="#596275"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="26dp" />

            <Button
                android:id="@+id/btnLaunch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_start_button"
                android:text="DÉMARRER LE SERVICE"
                android:textColor="@color/pulse_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:stateListAnimator="@null"
                android:layout_marginBottom="14dp" />

            <Button
                android:id="@+id/btnHalt"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_stop_button"
                android:text="ARRÊTER LE SERVICE"
                android:textColor="@color/pulse_white"
                android:textStyle="bold"
                android:textSize="15sp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>